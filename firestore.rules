rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return myUser().data.role;
    }

    function isAdmin() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'owner');
    }

    function isOwner() {
      return isSignedIn() && myRole() == 'owner';
    }

    // Vrai si la catégorie de bonus donnée ('top8'|'winner'|'finalist'|'topScorer')
    // a été verrouillée par un admin dans settings/bonusLocks.
    function isBonusLocked(category) {
      return exists(/databases/$(database)/documents/settings/bonusLocks)
        && get(/databases/$(database)/documents/settings/bonusLocks).data[category] == true;
    }

    // ---- pseudos (réservation de pseudo, vérifiée avant la création de compte) ----
    match /pseudos/{pseudoId} {
      allow read: if true; // tout le monde doit pouvoir vérifier si un pseudo est pris
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      // Un joueur peut modifier son propre profil, SAUF son rôle.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role) ||
        // Seul le propriétaire peut changer un rôle (nommer/retirer un admin).
        (isOwner() && request.resource.data.role != resource.data.role)
      );
      allow delete: if isOwner();
    }

    // ---- clubs ----
    match /clubs/{clubId} {
      allow read: if true; // classement public, pas besoin d'être connecté
      allow write: if isAdmin();
    }

    // ---- matches ----
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- predictions ----
    match /predictions/{predictionId} {
      allow read: if isSignedIn();

      // Un joueur ne peut créer/modifier QUE son propre pronostic,
      // et seulement si le match n'est pas encore verrouillé (30 min avant).
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.time < get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.locksAt;

      // Les champs de score (points, exact, correctResult) ne sont
      // modifiables que par un admin (après un match terminé).
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ---- seasonBonusPicks ----
    match /seasonBonusPicks/{uid} {
      allow read: if isSignedIn();

      // Premier enregistrement (le document n'existe pas encore) : ouvert,
      // peu importe l'état des verrous — un joueur doit toujours pouvoir
      // faire sa toute première sauvegarde.
      allow create: if isSignedIn() && request.auth.uid == uid;

      // Modification d'un pronostic déjà enregistré : chaque catégorie
      // (top8, winner, finalist, topScorer) ne peut changer de valeur QUE
      // si elle n'est pas verrouillée — les autres catégories restent
      // modifiables indépendamment.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource.data.top8 == resource.data.top8 || !isBonusLocked('top8'))
        && (request.resource.data.winner == resource.data.winner || !isBonusLocked('winner'))
        && (request.resource.data.finalist == resource.data.finalist || !isBonusLocked('finalist'))
        && (request.resource.data.topScorer == resource.data.topScorer || !isBonusLocked('topScorer'));

      allow write: if isAdmin();
    }

    // ---- seasonBonusResults ----
    match /seasonBonusResults/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- auditLog (journal des actions admin, visible par le owner seul) ----
    match /auditLog/{entryId} {
      allow read: if isOwner();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false; // le journal ne se modifie ni ne se supprime
    }

    // ---- settings (verrouillage inscriptions, dates de verrouillage) ----
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
